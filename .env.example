# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local).

# Designer IA — Gemini (gratuit) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : Claude, utilisé en priorité s'il est renseigné
ANTHROPIC_API_KEY=

# Supabase (Project Settings > API) : URL et clé publishable
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel : URL publique du site (SEO, sitemap)
NEXT_PUBLIC_SITE_URL=

# Optionnel : Higgsfield (génération d'images et de vidéos)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
